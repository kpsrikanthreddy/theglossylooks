# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (Default is 3000)
PORT=3000

# SUPABASE / POSTGRESQL CONFIGURATION (Optional - defaults to persistent JSON repository if not configured)
# Run /database/supabase_schema.sql in your Supabase SQL editor to create all tables and policies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# POS & THERMAL PRINT AGENT CONFIGURATION
PRINT_AGENT_SECRET="glossy_print_secret_2025"
DEFAULT_PRINT_DEVICE_ID="DEV-001"

# META WHATSAPP BUSINESS EMBEDDED SIGNUP & COEXISTENCE
META_APP_ID="your_meta_app_id"
META_EMBEDDED_SIGNUP_CONFIG_ID="your_embedded_signup_config_id"
# Server-only Meta secrets (never exposed to frontend or client bundle)
META_APP_SECRET="your_meta_app_secret"
META_BUSINESS_ID="your_meta_business_portfolio_id"
META_SYSTEM_USER_ACCESS_TOKEN="your_meta_system_user_access_token"
META_VERIFY_TOKEN="your_meta_webhook_verify_token"
WHATSAPP_API_VERSION="v22.0"
# Delay after a completed appointment before the automated feedback template is sent.
FEEDBACK_DELAY_MINUTES="30"
# This must be the publicly deployed HTTPS endpoint, not the AI Studio editor
# URL. The server handles GET verification and POST WhatsApp events here.
META_WEBHOOK_CALLBACK_URL="https://www.glossylooks.in/api/whatsapp/webhook"
GOOGLE_REVIEW_URL="https://g.page/r/CTx5NddxkeKaEAE/review"
# Server-only WhatsApp salon/admin alert numbers (digits with country code, e.g. 91XXXXXXXXXX; never expose as VITE_*)
WHATSAPP_GACHIBOWLI_ALERT_NUMBER=
WHATSAPP_KONDAPUR_ALERT_NUMBER=
WHATSAPP_ADMIN_ALERT_NUMBER=


# REQUIRED for secure salon admin sessions (server-only; 32+ random characters)
SALON_SESSION_SECRET=
# SMAV integration uses the scoped backend key, never SMAV service_role credentials.
# Set SMAV_GATEWAY_URL to the SMAV backend base URL so user sync calls:
#   POST ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/users/sync
SMAV_GATEWAY_URL=
GLOSSYLOOKS_INTEGRATION_KEY=
SMAV_SUPABASE_URL=https://qykdwswatopylzvqhgog.supabase.co
SMAV_SUPABASE_ANON_KEY=
# Optional fallback Edge Function override (only used when SMAV_GATEWAY_URL is unset)
SMAV_EDGE_FUNCTION_URL=
# Required only if direct Edge Function fallback is used. Set this to the
# current SMAV server-issued Edge Function JWT/API token, never a staff login
# access token. Prefer setting SMAV_GATEWAY_URL in production.
SMAV_EDGE_FUNCTION_AUTH_TOKEN=
# Optional secret protecting Vercel Cron endpoints (including /api/cron/smav-user-sync-outbox)
CRON_SECRET=

# SMAV Central Bill Numbering, Central Ledger & Signed Sale-Event Receiver (server-only)
# Uses SMAV_GATEWAY_URL + GLOSSYLOOKS_INTEGRATION_KEY + SMAV_DISPATCH_SECRET for:
#   - GET  ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/branches
#   - GET  ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/ledger
#   - POST ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/bill-numbers/reserve
#   - POST ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/bill-numbers/finalize
#   - POST ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/bills/upsert
#   - POST ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/bills/:billId/void
#   - POST ${SMAV_GATEWAY_URL}/api/integrations/glossylooks/bills/:billId/restore
#   - POST /api/integrations/smav/sale-event (validates X-Integration-Key + HMAC-SHA256)
SMAV_DISPATCH_SECRET=
SMAV_SALON_OUTLET_ID=
SMAV_SALON_BRANCH_MAP_JSON={"GACHI":"tgl-gachibowli-main","KONDA":"brn-1793346038689"}
SMAV_SALON_DEFAULT_BRANCH_ID=
# Optional endpoint URL overrides (ledger, upsert, void, and restore derive automatically from SMAV_GATEWAY_URL)
SMAV_BRANCHES_URL=
SMAV_BILL_RESERVE_URL=
SMAV_BILL_FINALIZE_URL=


