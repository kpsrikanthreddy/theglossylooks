# Glossy Looks Salon Environment Variables
PORT=3000

# Meta WhatsApp Cloud API Configuration
# Get these from Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="YOUR_META_PERMANENT_OR_SYSTEM_USER_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_META_WHATSAPP_BUSINESS_ACCOUNT_ID"

# Meta Webhook Verification & Security
# Create a secure random string and enter the same value in Meta App Dashboard -> Configuration -> Webhook
WHATSAPP_VERIFY_TOKEN="glossy_looks_webhook_verify_token_2026"
# App Secret from Meta App Dashboard -> App Settings -> Basic -> App Secret (for HMAC-SHA256 signature verification)
META_APP_SECRET="YOUR_META_APP_SECRET"

# WhatsApp Approved Template Configuration
WHATSAPP_FEEDBACK_TEMPLATE="glossylooks_feedback"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Customer Review URL (used for Good feedback response)
GOOGLE_REVIEW_URL="https://g.page/r/glossy-looks-gachibowli/review"

# Feedback Automation Delay in Minutes (Default: 30 minutes)
FEEDBACK_DELAY_MINUTES=30

# Supabase Persistent Database Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"

# Admin Internal API Authentication Secret
ADMIN_API_SECRET="glossy_looks_admin_jwt_secret_hyderabad_2026"
